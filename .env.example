# Application
APP_HOST=0.0.0.0
APP_PORT=8000

# Public hostname (GCP VPS subdomain). Used by TLS bootstrap script.
DOMAIN=voice-api.vabhatia.dev
CERTBOT_EMAIL=you@example.com

# Postgres (compose interpolates these into the postgres service)
# Use a strong password on the VPS — do not keep the defaults in production.
POSTGRES_USER=cart
POSTGRES_PASSWORD=cart
POSTGRES_DB=cart_recovery
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy async URL. Compose overrides this to use host `postgres`.
# For local non-compose runs, use localhost.
DATABASE_URL=postgresql+asyncpg://cart:cart@localhost:5432/cart_recovery

# Redis. Compose overrides this to use host `redis`.
REDIS_URL=redis://localhost:6379/0

# Store abandonment sweeper
CART_ABANDONMENT_TIMEOUT_SECONDS=1800
CART_ABANDONMENT_SWEEP_INTERVAL_SECONDS=10
CART_ABANDONMENT_SWEEPER_ENABLED=true
REDIS_ABANDONMENT_STREAM=store:cart-abandoned
REDIS_ABANDONMENT_EMITTED_PREFIX=store:abandonment
STORE_DELIVERY_FEE=4.99

# Deepgram streaming ASR (Nova-3) and TTS (Aura-2).
DEEPGRAM_API_KEY=

# Intent classification.
OPENAI_API_KEY=
INTENT_MODEL=gpt-4o-mini

# Origins allowed to call the HTTP API (WebSocket clients do not use CORS).
# Include wherever you host the voice UI pages.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
